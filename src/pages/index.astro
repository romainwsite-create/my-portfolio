  <!-- JS : carrousel circulaire des cartes -->
  <script>
    (function () {
      const stack = document.querySelector('.stack');
      if (!stack) return;
      const cards = Array.from(stack.querySelectorAll('.card'));
      if (!cards.length) return;

      function updateStack() {
        cards.forEach((card, i) => {
          if (card.classList.contains('leaving')) return;
          card.style.setProperty('--index', i);
        });
      }
      updateStack();

      let isAnimating = false;
      let wheelAcc = 0;
      const STEP_THRESHOLD = 70;
      const TRANSITION_MS = 700;

      function next() {
        if (isAnimating || !cards.length) return;
        isAnimating = true;

        const leaving = cards.shift();
        leaving.classList.add('leaving');
        leaving.style.zIndex = 1000;

        updateStack();

        const onEnd = (ev) => {
          if (ev.propertyName !== 'transform') return;
          leaving.classList.remove('leaving');
          leaving.style.zIndex = '';
          cards.push(leaving);
          updateStack();
          isAnimating = false;
          leaving.removeEventListener('transitionend', onEnd);
        };
        leaving.addEventListener('transitionend', onEnd);
      }

      function prev() {
        if (isAnimating || !cards.length) return;
        isAnimating = true;
        const coming = cards.pop();
        cards.unshift(coming);
        updateStack();
        setTimeout(() => { isAnimating = false; }, TRANSITION_MS);
      }

      stack.addEventListener('wheel', (e) => {
        e.preventDefault();
        if (isAnimating) return;
        wheelAcc += e.deltaY;
        if (Math.abs(wheelAcc) >= STEP_THRESHOLD) {
          wheelAcc > 0 ? next() : prev();
          wheelAcc = 0;
        }
      }, { passive: false });

      stack.tabIndex = 0;
      stack.addEventListener('keydown', (e) => {
        if (isAnimating) return;
        if (e.key === 'ArrowDown' || e.key === 'PageDown') next();
        if (e.key === 'ArrowUp'   || e.key === 'PageUp')   prev();
      });
    })();
  </script>

